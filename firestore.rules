rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin' ||
              get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superAdmin');
    }

    // Helper function to check if user is a nurse (nurses/{uid} exists)
    function isNurse() {
      return isAuthenticated() && exists(/databases/$(database)/documents/nurses/$(request.auth.uid));
    }

    // Helper: allow invoice creation if the authenticated user is the assigned nurse
    // for the referenced shift request.
    function isAssignedNurseForShift(shiftRequestId) {
      return isAuthenticated() &&
        shiftRequestId != null &&
        (
          get(/databases/$(database)/documents/shiftRequests/$(shiftRequestId)).data.nurseUid == request.auth.uid ||
          get(/databases/$(database)/documents/shiftRequests/$(shiftRequestId)).data.primaryNurseId == request.auth.uid ||
          get(/databases/$(database)/documents/shiftRequests/$(shiftRequestId)).data.assignedNurseId == request.auth.uid
        );
    }
    
    // Services collection - readable by anyone, writable by admins
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Profile edit requests collection
    match /profileEditRequests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.nurseId);
      allow delete: if isAdmin();
    }
    
    // Profile edit requests collection (lowercase variant)
    match /profileeditrequests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.nurseId);
      allow delete: if isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      // Allow public read so pre-login flows (username lookup, onboarding content) keep working
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Admins collection
    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      // Allow creation if:
      // 1. User is creating their own profile (for initial signup)
      // 2. OR user is authenticated (and the app layer validates they're an admin)
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == adminId || request.resource.data.get('role') == 'admin');
      allow delete: if isAuthenticated() && request.resource.data.get('role') == 'admin';
    }
    
    // Nurses collection
    match /nurses/{nurseId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == nurseId);
      allow delete: if isAdmin();
    }
    
    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Allow nurses and admins to update appointments (for coverage requests, status changes, etc.)
      // App layer handles authorization for specific operations
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Shift requests collection
    match /shiftRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Invoices collection
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();

      // Allow admins full control.
      allow write: if isAdmin();

      // Allow nurses to CREATE invoices they generated from the mobile app.
      // Also allow any authenticated user to create consultation invoices.
      // Updates/deletes remain admin-only to avoid tampering.
      allow create: if isAuthenticated() &&
        request.resource.data.createdByUid == request.auth.uid &&
        (
          isNurse() ||
          isAssignedNurseForShift(request.resource.data.shiftRequestId) ||
          request.resource.data.isConsultation == true
        );
      allow update, delete: if isAdmin();
    }

    // Consultation Requests collection (paid/scheduled consult calls)
    match /consultationRequests/{requestId} {
      // Allow admins to view all. Allow authenticated users to view their own (by patientAuthUid).
      allow read: if isAdmin() || (isAuthenticated() && resource.data.patientAuthUid == request.auth.uid);

      // Allow any authenticated user to create a request.
      // patientAuthUid, if present, must either be null or match the caller's UID.
      allow create: if isAuthenticated() && (
        !request.resource.data.keys().hasAny(['patientAuthUid']) ||
        request.resource.data.patientAuthUid == null ||
        request.resource.data.patientAuthUid == request.auth.uid
      );

      // Only admins can modify or delete requests.
      allow update, delete: if isAdmin();
    }

    // Medical Report Requests collection (paid report requests)
    match /medicalReportRequests/{requestId} {
      // Allow admins to view all. Allow authenticated users to view their own (by patientAuthUid).
      allow read: if isAdmin() || (isAuthenticated() && resource.data.patientAuthUid == request.auth.uid);

      // Allow any authenticated user to create a request.
      // The patientAuthUid must match the authenticated user.
      allow create: if isAuthenticated() && request.resource.data.patientAuthUid == request.auth.uid;

      // Only admins can modify or delete requests.
      allow update, delete: if isAdmin();
    }

    // Counters collection (used for invoice numbering)
    match /counters/{counterId} {
      // Allow authenticated reads so the client can attempt to use the shared counter.
      allow read: if isAuthenticated();

      // Only admins can seed/create counters.
      allow create, delete: if isAdmin();

      // Allow strict increment updates for the nurse invoice counter.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        counterId == 'nurseInvoiceNumber' &&
        (resource.data.sequence is int) &&
        (request.resource.data.sequence is int) &&
        request.resource.data.sequence == resource.data.sequence + 1 &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['sequence', 'updatedAt'])
      );
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Allow authenticated users to read their own notifications
      allow read, list: if isAuthenticated();
      // Allow any authenticated user to create notifications (e.g. booking/consultation events notifying admin)
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
      // Allow admins full update access
      allow update: if isAdmin();
      // Allow users to mark their own notifications as read
      // Check userId field exists and matches, or allow if notification was just created for this user
      allow update: if isAuthenticated() && 
        (
          (resource.data.keys().hasAny(['userId']) && resource.data.userId == request.auth.uid) ||
          (resource.data.keys().hasAny(['recipientId']) && resource.data.recipientId == request.auth.uid) ||
          (resource.data.keys().hasAny(['uid']) && resource.data.uid == request.auth.uid)
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'isRead', 'readAt']);
    }
    
    // Store products collection
    match /storeProducts/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Store orders collection
    match /storeOrders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.customerId || isAdmin());
      allow delete: if isAdmin();
    }

    // Patients collection (used for admin client selectors)
    match /patients/{patientId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Payslips collection
    match /payslips/{payslipId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Payments collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Payment settings collection
    match /paymentSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Privacy settings collection
    match /privacySettings/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Mail queue (processed by Firebase Cloud Functions)
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
